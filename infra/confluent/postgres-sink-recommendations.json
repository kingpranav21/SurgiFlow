{
  "name": "surgiflow-recommendations-sink",
  "config": {
    "connector.class": "PostgresSink",
    "name": "surgiflow-recommendations-sink",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "${KAFKA_API_KEY}",
    "kafka.api.secret": "${KAFKA_API_SECRET}",
    "connection.host": "${PG_HOST}",
    "connection.port": "5432",
    "connection.user": "${PG_USER}",
    "connection.password": "${PG_PASSWORD}",
    "db.name": "${PG_DATABASE}",
    "ssl.mode": "require",
    "input.data.format": "AVRO",
    "input.key.format": "AVRO",
    "topics": "recommendations",
    "tasks.max": "1",
    "auto.create": "false",
    "auto.evolve": "false",
    "insert.mode": "INSERT",
    "table.name.format": "recommendations",
    "pk.mode": "none",
    "fields.whitelist": "source_hospital_id,target_hospital_id,product_id,quantity,reason,status"
  }
}
