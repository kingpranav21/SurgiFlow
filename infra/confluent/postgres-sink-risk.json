{
  "name": "surgiflow-risk-sink",
  "config": {
    "connector.class": "PostgresSink",
    "name": "surgiflow-risk-sink",
    "kafka.auth.mode": "KAFKA_API_KEY",
    "kafka.api.key": "${KAFKA_API_KEY}",
    "kafka.api.secret": "${KAFKA_API_SECRET}",
    "connection.host": "${PG_HOST}",
    "connection.port": "5432",
    "connection.user": "${PG_USER}",
    "connection.password": "${PG_PASSWORD}",
    "db.name": "${PG_DATABASE}",
    "ssl.mode": "require",
    "input.data.format": "AVRO",
    "input.key.format": "AVRO",
    "topics": "stockout_risk",
    "tasks.max": "1",
    "auto.create": "false",
    "auto.evolve": "false",
    "insert.mode": "INSERT",
    "table.name.format": "risk_predictions",
    "pk.mode": "none",
    "fields.whitelist": "hospital_id,product_id,risk_level,current_inventory,projected_demand,projected_inventory,predicted_stockout,reason"
  }
}
