# Local Docker Postgres (or Homebrew). For Confluent CDC use a public Neon URL.
DATABASE_URL=postgresql://surgiflow:surgiflow@localhost:5432/surgiflow

# Prefer Python 3.11 or 3.12
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pipeline:
#   local  = Python risk engine only (no Kafka)
#   hybrid = publish to Kafka AND run local engine (best while wiring Flink)
#   kafka  = Kafka path only (stream_processor or Confluent Flink must run)
PIPELINE_MODE=local

# --- Local Redpanda (docker compose -f docker-compose.kafka.yml up -d) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# --- Confluent Cloud (from Cluster → Settings → Bootstrap server) ---
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Topic names (defaults match Flink SQL)
# TOPIC_INVENTORY=surgiflow.inventory.events
# TOPIC_SHIPMENT=surgiflow.shipment.events

# Legacy aliases (optional)
CONFLUENT_BOOTSTRAP_SERVERS=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
SCHEMA_REGISTRY_URL=
FLINK_COMPUTE_POOL_ID=
CONFLUENT_ENVIRONMENT_ID=
CONFLUENT_CLUSTER_ID=
